{
  "openapi": "1.0.0",
  "info": {
    "title": "Kyzen.id",
    "author": "Kyzen.id",
    "version": "v2.0.0",
    "description": "REST API canvas image generation."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Canvas"
    }
  ],
  "paths": {
    "/canvas/ignote": {
      "get": {
        "summary": "IG Note",
        "description": "Generate gambar catatan (note) ala Instagram.",
        "tags": ["Canvas"],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "description": "Username yang ditampilkan", "schema": { "type": "string" } },
          { "name": "text", "in": "query", "required": true, "description": "Isi teks note (maks 7 kata)", "schema": { "type": "string" } },
          { "name": "time", "in": "query", "required": false, "description": "Teks waktu (opsional)", "schema": { "type": "string" } },
          { "name": "ppUrl", "in": "query", "required": false, "description": "URL foto profil (opsional)", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Gambar PNG" }, "400": { "description": "Parameter tidak lengkap" } }
      }
    },
    "/canvas/waquote": {
      "get": {
        "summary": "WhatsApp Quote",
        "description": "Generate gambar bubble chat WhatsApp bergaya quote.",
        "tags": ["Canvas"],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "description": "Nama pengirim", "schema": { "type": "string" } },
          { "name": "phone", "in": "query", "required": true, "description": "Nomor telepon pengirim", "schema": { "type": "string" } },
          { "name": "ppUrl", "in": "query", "required": true, "description": "URL foto profil pengirim", "schema": { "type": "string" } },
          { "name": "text", "in": "query", "required": false, "description": "Isi teks chat (wajib diisi kalau imgUrl kosong)", "schema": { "type": "string" } },
          { "name": "imgUrl", "in": "query", "required": false, "description": "URL gambar chat (wajib diisi kalau text kosong)", "schema": { "type": "string" } },
          { "name": "tag", "in": "query", "required": false, "description": "Label tag (opsional)", "schema": { "type": "string" } },
          { "name": "mode", "in": "query", "required": false, "description": "Mode tampilan (opsional)", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Gambar PNG" }, "400": { "description": "Parameter tidak lengkap" } }
      }
    },
    "/canvas/wq": {
      "get": {
        "summary": "WhatsApp Quote (Simple)",
        "description": "Generate gambar quote teks sederhana bergaya WhatsApp.",
        "tags": ["Canvas"],
        "parameters": [
          { "name": "text", "in": "query", "required": true, "description": "Isi teks quote", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Gambar PNG" }, "400": { "description": "Parameter tidak lengkap" } }
      }
    },
    "/canvas/twobuttons": {
      "get": {
        "summary": "Two Buttons Meme",
        "description": "Generate meme template \"dua tombol\" dengan teks kustom.",
        "tags": ["Canvas"],
        "parameters": [
          { "name": "teks1", "in": "query", "required": true, "description": "Teks tombol pertama", "schema": { "type": "string" } },
          { "name": "teks2", "in": "query", "required": true, "description": "Teks tombol kedua", "schema": { "type": "string" } },
          { "name": "teks3", "in": "query", "required": true, "description": "Teks judul/karakter", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Gambar PNG" }, "400": { "description": "Parameter tidak lengkap" } }
      }
    },
    "/canvas/jarvismeme": {
      "get": {
        "summary": "Jarvis Meme",
        "description": "Generate meme template Jarvis dengan teks kustom.",
        "tags": ["Canvas"],
        "parameters": [
          { "name": "text", "in": "query", "required": true, "description": "Isi teks meme", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Gambar PNG" }, "400": { "description": "Parameter tidak lengkap" } }
      }
    },
    "/canvas/drakememe": {
      "get": {
        "summary": "Drake Meme",
        "description": "Generate meme template Drake (tolak/setuju) dengan dua teks.",
        "tags": ["Canvas"],
        "parameters": [
          { "name": "teks1", "in": "query", "required": true, "description": "Teks panel atas (ditolak)", "schema": { "type": "string" } },
          { "name": "teks2", "in": "query", "required": true, "description": "Teks panel bawah (disetujui)", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Gambar PNG" }, "400": { "description": "Parameter tidak lengkap" } }
      }
    },
    "/canvas/igqc": {
      "get": {
        "summary": "IG Quote Card",
        "description": "Generate gambar quote card ala Instagram, dari teks atau gambar.",
        "tags": ["Canvas"],
        "parameters": [
          { "name": "txt", "in": "query", "required": false, "description": "Isi teks quote (wajib diisi kalau imgUrl kosong)", "schema": { "type": "string" } },
          { "name": "imgUrl", "in": "query", "required": false, "description": "URL gambar (wajib diisi kalau txt kosong)", "schema": { "type": "string" } },
          { "name": "time", "in": "query", "required": false, "description": "Teks waktu (opsional)", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Gambar PNG" }, "400": { "description": "Parameter tidak lengkap" } }
      }
    },
    "/canvas/fakenotifwa": {
      "get": {
        "summary": "Fake WhatsApp Notification",
        "description": "Generate gambar notifikasi palsu ala WhatsApp.",
        "tags": ["Canvas"],
        "parameters": [
          { "name": "ppUrl", "in": "query", "required": true, "description": "URL foto profil pengirim", "schema": { "type": "string" } },
          { "name": "username", "in": "query", "required": true, "description": "Nama pengirim", "schema": { "type": "string" } },
          { "name": "chat", "in": "query", "required": true, "description": "Isi teks notifikasi", "schema": { "type": "string" } },
          { "name": "tanggal", "in": "query", "required": false, "description": "Teks tanggal (opsional)", "schema": { "type": "string" } },
          { "name": "jam", "in": "query", "required": false, "description": "Teks jam (opsional)", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Gambar PNG" }, "400": { "description": "Parameter tidak lengkap" } }
      }
    }
  }
}
